// Every chart type
root = Card([header, bars, trend, share, half, parts, rings, radar, scatter])
header = CardHeader("Support dashboard", "Charts of every kind")
bars = SectionBlock([s1])
s1 = SectionItem("bars", "Bars", [barChart, rankChart])
barChart = BarChart(["Jan", "Feb", "Mar", "Apr"], [opened, closed], "grouped", "Month", "Tickets")
opened = Series("Opened", [42, 51, 47, 60])
closed = Series("Closed", [38, 49, 52, 55])
rankChart = HorizontalBarChart(["Email", "Chat", "Phone", "Social"], [channel], "grouped", "Tickets")
channel = Series("Tickets", [120, 96, 54, 31])
trend = SectionBlock([s2])
s2 = SectionItem("trend", "Trends", [lineChart, areaChart])
lineChart = LineChart(["Jan", "Feb", "Mar", "Apr"], [opened, closed], "natural")
areaChart = AreaChart(["Jan", "Feb", "Mar", "Apr"], [opened], "step")
share = PieChart(["Email", "Chat", "Phone", "Social"], [120, 96, 54, 31], "donut")
half = PieChart(["Open", "Waiting", "Done"], [18, 9, 73], "pie", "semiCircular")
parts = SingleStackedBarChart(["Open", "Waiting", "Done"], [18, 9, 73])
rings = RadialChart(["Email", "Chat", "Phone"], [80, 55, 30])
radar = RadarChart(["Speed", "Quality", "Tone", "Accuracy", "Coverage"], [teamA, teamB])
teamA = Series("Team A", [4, 5, 3, 4, 4])
teamB = Series("Team B", [3, 4, 5, 4, 2])
scatter = ScatterChart([ScatterSeries("Agents", [Point(2, 40), Point(5, 62), Point(8, 75, 12), Point(11, 90, 30)])], "Years on the team", "Tickets a day")
