{
  "name": "TextField",
  "description": "Variants, a secret field with checks, and a field with no data binding.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "components-textfield-variants",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "components-textfield-variants",
        "components": [
          {"id": "root", "component": "Column", "children": ["variant_title", "c"]},
          {"id": "variant_title", "component": "Text", "text": "shortText, longText and number", "variant": "caption"},
          {"id": "c", "component": "Column", "children": ["s", "l", "n"]},
          {"id": "s", "component": "TextField", "label": "Name", "placeholder": "Jane Doe", "value": {"@path": "/name"}},
          {"id": "l", "component": "TextField", "label": "About", "variant": "longText", "value": {"@path": "/about"}},
          {"id": "n", "component": "TextField", "label": "Guests", "variant": "number", "value": {"@path": "/guests"}}
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "components-textfield-variants",
        "value": {
          "name": "",
          "about": "",
          "guests": "2"
        }
      }
    },
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "components-textfield-secret",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "components-textfield-secret",
        "components": [
          {"id": "root", "component": "Column", "children": ["variant_title", "p"]},
          {"id": "variant_title", "component": "Text", "text": "obscured, with checks that show once there is text", "variant": "caption"},
          {"id": "p", "component": "TextField", "label": "Password", "variant": "obscured", "value": {"@path": "/password"}, "checks": [{"condition": {"@call": "length", "args": {"value": {"@path": "/password"}, "min": 8}}, "message": "Use at least 8 characters."}]}
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "components-textfield-secret",
        "value": {
          "password": ""
        }
      }
    },
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "components-textfield-unbound",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "components-textfield-unbound",
        "components": [
          {"id": "root", "component": "Column", "children": ["variant_title", "u"]},
          {"id": "variant_title", "component": "Text", "text": "Not bound to the data model: read-only, and reported", "variant": "caption"},
          {"id": "u", "component": "TextField", "label": "Fixed", "value": "Written by the agent"}
        ]
      }
    }
  ]
}
