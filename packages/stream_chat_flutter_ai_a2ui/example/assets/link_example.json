{
  "name": "A link",
  "description": "A button whose action opens a web page, outside the app.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "gallery-link",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "gallery-link",
        "components": [
          {"id": "root", "component": "Card", "child": "content"},
          {"id": "content", "component": "Column", "children": ["about", "open"]},
          {"id": "about", "component": "Text", "text": "Ohrid sits on the shore of Lake Ohrid, one of Europe's oldest lakes."},
          {
            "id": "open",
            "component": "Button",
            "variant": "primary",
            "child": "open_label",
            "action": {"functionCall": {"@call": "openUrl", "args": {"url": "https://en.wikipedia.org/wiki/Ohrid"}}}
          },
          {"id": "open_label", "component": "Text", "text": "Read about Ohrid"}
        ]
      }
    }
  ]
}
